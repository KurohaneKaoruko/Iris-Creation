{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iris-Creation",
  "version": "0.1.1-rc.6",
  "identifier": "com.iriscreation.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir webui dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm --dir webui build",
    "frontendDist": "../webui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Iris-Creation",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": {
      "../webui/dist/": "frontend/"
    },
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
